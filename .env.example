GCP_PROJECT_ID=fes-quote
GCP_STORAGE_BUCKET=
GCP_FIRESTORE_DATABASE=(default)
# Use Vercel OIDC federation in production; no Google service account key needs to be stored.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Optional fallback, added privately in Vercel Environment Variables; never commit a real key.
GCP_SERVICE_ACCOUNT_JSON=
FES_ADMIN_USER=admin
# Set a unique owner password with at least 16 characters in the hosting environment.
FES_ADMIN_PASSWORD=
QUOTE_CAP_CAD=
# Add the approved private JSON price profile as a sensitive Vercel variable.
FES_PRICING_JSON=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Local testing only; this is explicitly ignored by deployed Vercel functions.
FES_LOCAL_STORAGE=0
